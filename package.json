{
  "name": "zeiterfassung",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Self-hosted time tracking for small German companies",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:cleanup-demo": "tsx prisma/cleanup-demo.ts",
    "db:reset-audit": "tsx prisma/reset-audit.ts",
    "db:reset-timesheet": "tsx prisma/reset-timesheet.ts",
    "db:recount-vacation": "tsx prisma/recount-vacation.ts",
    "db:check-integrity": "tsx prisma/check-integrity.ts",
    "db:check-midnight": "tsx prisma/check-midnight-starts.ts",
    "db:split-vacation": "tsx prisma/split-vacation-entitlement.ts",
    "_DANGER_db:reset": "echo 'Refusing to run: this DROPS THE ENTIRE DATABASE. It sat one tab-completion away from db:seed in a production shell. If you really mean it, run npx prisma migrate reset --force yourself and check DATABASE_URL first.' && exit 1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "date-holidays": "^3.30.2",
    "lucide-react": "^1.18.0",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.15",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
