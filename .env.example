# ─────────────────────────────────────────────────────────────────────────────
# Zeiterfassung — environment variables
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit a real `.env` — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (same engine in dev and prod to avoid drift).
# Local dev (docker-compose.dev.yml):
DATABASE_URL="postgresql://zeit:zeit@localhost:5432/zeiterfassung?schema=public"
# On Railway: set this to the managed Postgres "DATABASE_URL" reference variable.

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Secret used to sign session cookies / JWTs. Generate with:
#   npx auth secret      (or)   openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-long-random-value"

# Public base URL of the app. Required in production behind a proxy (Railway
# sets the domain for you). Locally this can be left as the default.
AUTH_URL="http://localhost:3000"

# Mark cookies Secure and trust the proxy host in production.
# Railway terminates TLS, so set this to "true" in production.
AUTH_TRUST_HOST="true"

# ── Seed (first admin) ───────────────────────────────────────────────────────
# Used only by `npm run db:seed` to create the initial administrator.
SEED_ADMIN_EMAIL="admin@firma.de"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="System-Administrator"

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
# Default Bundesland used when seeding public holidays (per-employee override
# is also supported). NRW = Nordrhein-Westfalen.
DEFAULT_BUNDESLAND="NW"
# IANA timezone used for all day-boundary calculations.
APP_TIMEZONE="Europe/Berlin"
# Header your reverse proxy SETS to the real client IP (login throttling).
# Railway: x-real-ip (default). Cloudflare: cf-connecting-ip.
# CLIENT_IP_HEADER="x-real-ip"
